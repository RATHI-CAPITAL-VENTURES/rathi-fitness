<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rathi.fitness.autoinstall</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ishan/RIA/projects/rathi-fitness/bin/rf-autoinstall.sh</string>
    </array>

    <!-- Ten minutes, not two. RIA's server deploy is a `git pull` and a
         restart; this one may run a full Xcode build, so polling hard would
         put a compile on the machine every couple of minutes for nothing.
         The cheap check (git fetch) still runs each tick and exits in
         milliseconds when there is nothing new. -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Nice, because a build should never be what makes the Mac stutter. -->
    <key>Nice</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/ishan/Library/Logs/rathi-fitness/autoinstall.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ishan/Library/Logs/rathi-fitness/autoinstall.err.log</string>
</dict>
</plist>

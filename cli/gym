#!/usr/bin/env python3
"""gym — read what the Rathi Fitness app knows, from the Mac.

The phone owns the data. A CloudKit *private* database has no command-line read
path, so the app writes a JSON snapshot into its iCloud Drive container, which
on macOS is an ordinary file that syncs itself. This reads that file.

    gym today          the day's plan and how far through it you are
    gym weight         body weight, the trend, and a sparkline
    gym lifts          working weight per exercise, and the 30-day change
    gym exercise NAME  one lift's history
    gym sessions       recent workouts
    gym muscles        working sets per muscle group over a window
    gym passes         stored gym passes (metadata only — never the codes)
    gym status         where the snapshot is and how stale

Every command takes --json for a machine (RIA reads these through tools/gym.py).

The snapshot is found at $GYM_SNAPSHOT, else the iCloud Drive container. It is
written by the app, never by this tool: gym is read-only by design, so nothing
here can disagree with the phone.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
from pathlib import Path

# 4 — assisted machines. `assisted: true` inverts what an exercise's numbers
# MEAN: `working_weight` is how much HELP you needed, so lower is better and a
# negative `change_30d` is progress. Never print it as a heavier lift.
#
# 3 — cardio and machine settings. An exercise may be `modality: "cardio"`, in
# which case its `volume` and `working_weight` are zero and MEAN NOTHING; its
# numbers live in `cardio` blocks. `machine_settings` says where the seat goes.
# See docs/SNAPSHOT.md.
SCHEMA_SUPPORTED = 5

CONTAINER = Path.home() / "Library" / "Mobile Documents" / \
    "iCloud~com~rathi~fitness" / "Documents" / "snapshot.json"

SPARK = "▁▂▃▄▅▆▇█"


# --------------------------------------------------------------------------- io

class NoSnapshot(Exception):
    """The app has never written, or iCloud has not synced it down yet."""


def snapshot_path() -> Path:
    override = os.environ.get("GYM_SNAPSHOT")
    return Path(override).expanduser() if override else CONTAINER


def load() -> dict:
    path = snapshot_path()
    if not path.exists():
        raise NoSnapshot(
            f"No snapshot at {path}.\n"
            "  · Open Rathi Fitness on the phone once — it writes on launch.\n"
            "  · Check the phone is signed into iCloud with iCloud Drive on.\n"
            "  · Or point GYM_SNAPSHOT at a file yourself."
        )
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as e:
        raise NoSnapshot(f"{path} is not valid JSON ({e}). It may be mid-sync; try again.")
    schema = data.get("schema")
    if schema != SCHEMA_SUPPORTED:
        # Refuse rather than misread: a field that changed meaning is worse than
        # no answer, because the wrong answer looks like an answer. But say which
        # side is behind — "update whichever is older" is a puzzle, not advice.
        if isinstance(schema, int) and schema < SCHEMA_SUPPORTED:
            raise NoSnapshot(
                f"This snapshot is schema {schema}; gym reads {SCHEMA_SUPPORTED}.\n"
                "  The phone hasn't written since the app was updated — open Rathi\n"
                "  Fitness once and it rewrites on launch. Nothing is lost meanwhile."
            )
        raise NoSnapshot(
            f"This snapshot is schema {schema}; gym only reads {SCHEMA_SUPPORTED}.\n"
            "  The app on the phone is newer than this CLI — pull the latest\n"
            "  rathi-fitness and try again."
        )
    return data


# ----------------------------------------------------------------- formatting

def num(v) -> str:
    """185.0 prints as 185; 2.5 keeps its half; float noise is rounded away."""
    if v is None:
        return "—"
    v = round(float(v), 1)
    return str(int(v)) if v == int(v) else f"{v:g}"


def signed(v) -> str:
    if v is None or abs(v) < 0.05:
        return "—"
    return ("+" if v > 0 else "−") + num(abs(v))


def parse_ts(s: str) -> dt.datetime | None:
    if not s:
        return None
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def ago(when: dt.datetime | None) -> str:
    if when is None:
        return "unknown"
    now = dt.datetime.now(dt.timezone.utc)
    if when.tzinfo is None:
        when = when.replace(tzinfo=dt.timezone.utc)
    secs = (now - when).total_seconds()
    if secs < 90:
        return "just now"
    for size, name in ((3600, "minute"), (86400, "hour"), (86400 * 30, "day")):
        if secs < size * 60 or name == "day":
            n = int(secs // (size if name != "minute" else 60))
            if name == "minute":
                n = int(secs // 60)
            elif name == "hour":
                n = int(secs // 3600)
            else:
                n = int(secs // 86400)
            if n <= 0:
                continue
            return f"{n} {name}{'s' if n != 1 else ''} ago"
    return "a while ago"


def clock(seconds) -> str:
    """1320 → `22 min`; 5400 → `1 h 30 min`. Minutes, because that is the unit
    every guideline about cardio is written in."""
    if not seconds:
        return "—"
    minutes = round(seconds / 60)
    if minutes >= 60:
        hours, rest = divmod(minutes, 60)
        return f"{hours} h" if rest == 0 else f"{hours} h {rest} min"
    return f"{minutes} min"


def miles(v) -> str:
    if not v:
        return "—"
    return f"{v:.2f}" if v < 10 else f"{v:.1f}"


def cardio_line(block: dict) -> str:
    """One cardio block as a sentence. Only the parts that were recorded — a
    treadmill you did not enter a grade for should not read `0%`."""
    if not block:
        return ""
    parts = []
    if block.get("seconds"):
        parts.append(clock(block["seconds"]))
    if block.get("distance"):
        parts.append(f"{miles(block['distance'])} mi")
    if block.get("average_incline"):
        parts.append(f"{block['average_incline']:g}% grade")
    if block.get("average_speed"):
        parts.append(f"{block['average_speed']:g} mph")
    if block.get("bouts", 0) > 1:
        parts.append(f"{block['bouts']} bouts")
    return " · ".join(parts)


def cardio_target_line(target: dict) -> str:
    if not target:
        return "no target"
    parts = []
    if target.get("seconds"):
        parts.append(clock(target["seconds"]))
    if target.get("distance"):
        parts.append(f"{miles(target['distance'])} mi")
    if target.get("incline"):
        parts.append(f"{target['incline']:g}% grade")
    if target.get("speed"):
        parts.append(f"{target['speed']:g} mph")
    if target.get("resistance"):
        parts.append(f"level {target['resistance']:g}")
    return " · ".join(parts) or "no target"


def assisted_change(v) -> str:
    """The 30-day change on an assisted machine, with the direction named.

    `signed()` alone is honest about the number and misleading about the fact:
    "−10" under a column headed "30d" reads as losing ground, when taking ten
    pounds off a pull-up assist is the whole point of doing them."""
    if not v:
        return "—"
    return f"−{num(abs(v))} help" if v < 0 else f"+{num(v)} help"


def plural(n, word: str) -> str:
    """`1 workout`, `3 workouts`. The volume table said "1 sessions"."""
    return f"{n} {word}" if n == 1 else f"{n} {word}s"


def tonnage(pounds: float) -> str:
    """Total load moved. Tons past 20k, because six digits of pounds stops
    meaning anything you can picture."""
    if not pounds:
        return "nothing yet"
    if pounds < 20_000:
        return f"{int(round(pounds)):,} lb"
    return f"{pounds / 2000:.1f} tons"


def sparkline(values: list[float]) -> str:
    if not values:
        return ""
    lo, hi = min(values), max(values)
    if hi - lo < 1e-9:
        return SPARK[3] * len(values)
    return "".join(SPARK[min(7, int((v - lo) / (hi - lo) * 7.999))] for v in values)


def emit(args, payload, text: str) -> None:
    print(json.dumps(payload, indent=2) if args.json else text)


# ------------------------------------------------------------------- commands

def cmd_today(args, data) -> None:
    today = data.get("today")
    body = data.get("body_weight", {})
    if not today:
        payload = {"training": False, "body_weight": body.get("current")}
        emit(args, payload,
             "Rest day — nothing scheduled.\n"
             f"Body weight {num(body.get('current'))} lb")
        return

    lines = [f"{today['day']} · {today['date']}",
             f"{today['exercises_done']} of {today['exercises_planned']} done · "
             f"{today['sets_done']} of {today['sets_planned']} sets", ""]
    for item in today["items"]:
        if item.get("modality") == "cardio":
            mark = "✓" if item["done"] else "·"
            did = cardio_line(item.get("cardio") or {})
            tail = did or cardio_target_line(item.get("cardio_target") or {})
            target = item.get("cardio_target") or {}
            planned = clock(target.get("seconds")) if target.get("seconds") else "—"
            lines.append(f"  {mark} {item['name']:<22} {planned:>8}   {tail}")
            continue
        working = [p for p in item["performed"] if p.get("kind", "working") != "warmup"]
        if item["done"]:
            mark, tail = "✓", "all " + str(item["sets_done"]) + " hit"
            reps = [p["reps"] for p in working]
            if reps and any(r < item["target_reps"] for r in reps):
                tail = "got " + ", ".join(str(r) for r in reps)
            hard = [p["rpe"] for p in working if p.get("rpe")]
            if hard:
                tail += f" · RPE {max(hard):g}"
            if item.get("warmup_sets"):
                tail += f" · +{item['warmup_sets']} warm-up"
        elif item["sets_done"]:
            mark = "→"
            tail = f"set {item['sets_done']} of {item['target_sets']}"
        else:
            mark, tail = "·", f"{item['target_sets']} × {item['target_reps']}"
        lines.append(f"  {mark} {item['name']:<22} {num(item['target_weight']):>5} lb   {tail}")
    moved = today.get("volume") or 0
    minutes = sum((i.get("cardio") or {}).get("seconds", 0) for i in today["items"])
    if moved or minutes:
        summary = []
        if moved:
            summary.append(f"Moved today: {tonnage(moved)}")
        if minutes:
            summary.append(f"Cardio: {clock(minutes)}")
        lines += ["", "  ·  ".join(summary)]
    lines += ["", f"Body weight {num(body.get('current'))} lb "
                  f"({signed(body.get('change_30d'))} in 30 days)"]
    emit(args, today, "\n".join(lines))


def cmd_weight(args, data) -> None:
    body = data.get("body_weight", {})
    history = body.get("history", [])
    if args.days:
        history = history[-args.days:]
    values = [h["lb"] for h in history]
    lines = ["Body weight",
             f"  {num(body.get('current'))} lb   as of {body.get('current_date') or '—'}",
             f"  {signed(body.get('change_30d'))} lb over 30 days · "
             f"trending {signed(body.get('trend_per_week'))}/wk"]
    if values:
        lines += ["", f"  {sparkline(values)}",
                  f"  {min(values):g} → {max(values):g} lb over {len(values)} weigh-ins"]
    emit(args, {"body_weight": body, "shown": history}, "\n".join(lines))


def cmd_muscles(args, data) -> None:
    """Working sets per muscle. Primary movers count 1, secondary 0.5 — the same
    convention the app uses, so the two cannot disagree."""
    # `--days 7` means today and the six before it, the way anyone reading
    # "last 7 days" expects — not today minus seven, which is eight days.
    cutoff = (dt.date.today() - dt.timedelta(days=max(0, args.days - 1))).isoformat()
    by_muscle: dict[str, float] = {}
    unmapped = 0
    for ex in data.get("exercises", []):
        sets = 0
        for line in ex.get("recent", []):
            if line["date"] >= cutoff:
                sets += len(line.get("reps") or [])
        if not sets:
            continue
        primary = ex.get("primary_muscle") or "other"
        if primary == "other":
            unmapped += sets
            continue
        by_muscle[primary] = by_muscle.get(primary, 0) + sets
        for muscle in ex.get("secondary_muscles") or []:
            # Half a set EACH, per set — not half a set per exercise, which is
            # what this said first and which made a hard session of pressing
            # look like half a set of triceps work.
            by_muscle[muscle] = by_muscle.get(muscle, 0) + 0.5 * sets

    if not by_muscle:
        note = ("No exercise says what it works yet — set it in the app under "
                "Edit the plan › an exercise › Muscles.") if unmapped else "Nothing logged."
        emit(args, {}, note)
        return

    rows = sorted(by_muscle.items(), key=lambda kv: -kv[1])
    peak = rows[0][1]
    lines = []
    for muscle, sets in rows:
        bar = "█" * max(1, int(round(sets / peak * 24)))
        lines.append(f"  {muscle:<12} {sets:>5g}  {bar}")
    if unmapped:
        lines.append(f"\n  {unmapped} sets from exercises with no muscle set.")
    emit(args, dict(rows), f"Working sets per muscle · last {args.days} days\n"
         + "\n".join(lines))


def cmd_lifts(args, data) -> None:
    # Cardio has no working weight, and printing one would be inventing it.
    # `gym cardio` is where a treadmill answers for itself.
    rows = [e for e in data.get("exercises", [])
            if e.get("modality", "strength") != "cardio"
            and e.get("working_weight") is not None]
    rows.sort(key=lambda e: -(e.get("working_weight") or 0))
    lines = [f"  {'':<22}{'now':>6}{'30d':>11}   {'last':<10}"]
    for e in rows:
        if e.get("assisted"):
            # A row that means the opposite of the ones around it has to say so
            # on its own line — a reader scanning the column cannot be expected
            # to remember which machines counterweight you.
            change = assisted_change(e.get("change_30d"))
            name = e["name"] + " *"
        else:
            change = signed(e.get("change_30d"))
            name = e["name"]
        lines.append(f"  {name:<22}{num(e['working_weight']):>6}"
                     f"{change:>11}   {e.get('last_performed') or '—'}")
    if any(e.get("assisted") for e in rows):
        lines.append("")
        lines.append("  * assisted — the number is how much HELP you needed, so down is up.")
    emit(args, rows, "Working weight\n" + "\n".join(lines))


def cmd_exercise(args, data) -> None:
    want = args.name.lower().replace(" ", "-")
    matches = [e for e in data.get("exercises", [])
               if want in e["slug"] or want in e["name"].lower().replace(" ", "-")]
    if not matches:
        known = ", ".join(sorted(e["slug"] for e in data.get("exercises", []))[:12])
        print(f"No exercise matching {args.name!r}.\nKnown: {known} …", file=sys.stderr)
        raise SystemExit(1)
    e = matches[0]
    muscles = e.get("primary_muscle") or "other"
    if muscles != "other" and e.get("secondary_muscles"):
        muscles += " + " + ", ".join(e["secondary_muscles"])
    is_cardio = e.get("modality", "strength") == "cardio"
    kind = "cardio" if is_cardio else (
        f"assisted {e['loading']}" if e.get("assisted") else e["loading"])
    lines = [f"{e['name']}  ({kind}"
             + (f", {muscles}" if muscles != "other" else "") + ")"]

    if is_cardio:
        best = e.get("cardio_best") or {}
        bits = []
        if best.get("farthest"):
            bits.append(f"furthest {miles(best['farthest'])} mi")
        if best.get("longest_seconds"):
            bits.append(f"longest {clock(best['longest_seconds'])}")
        if best.get("fastest"):
            bits.append(f"fastest {best['fastest']:g} mph")
        lines.append("  " + (" · ".join(bits) if bits else "nothing logged yet"))
    elif e.get("assisted"):
        lines.append(f"  help    {num(e.get('working_weight'))} lb · "
                     f"{assisted_change(e.get('change_30d'))} in 30 days")
        best = e.get("best")
        if best:
            lines.append(f"  least   {num(best['weight'])} lb help × {best['reps']} "
                         f"on {best['date']}")
        lines.append("  (assisted machine — less help is the progress)")
    else:
        lines.append(f"  working {num(e.get('working_weight'))} lb · "
                     f"{signed(e.get('change_30d'))} in 30 days")
        best = e.get("best")
        if best:
            lines.append(f"  best    {num(best['weight'])} × {best['reps']} on {best['date']}")

    # Where the machine goes. Printed near the top on purpose: it is the thing
    # you want BEFORE you get there, which is the whole reason it is recorded.
    settings = e.get("machine_settings") or []
    if settings:
        lines.append("  set to  "
                     + " · ".join(f"{m['label'].lower()} {m['value']}" for m in settings))

    lines.append("")
    for s in e.get("recent", []):
        if is_cardio:
            lines.append(f"  {s['date']}   {cardio_line(s.get('cardio') or {})}")
            continue
        reps = ", ".join(str(r) for r in s["reps"])
        extra = ""
        if s.get("average_rpe"):
            extra += f"  RPE {s['average_rpe']:g}"
        if s.get("warmup_sets"):
            extra += f"  (+{s['warmup_sets']} warm-up)"
        lines.append(f"  {s['date']}   {num(s['top_weight']):>5} · {reps}{extra}")

    if is_cardio:
        spark = [(s.get("cardio") or {}).get("seconds", 0)
                 for s in reversed(e.get("recent", []))]
    else:
        spark = [s["top_weight"] for s in reversed(e.get("recent", []))]
    if len(spark) > 1:
        lines += ["", f"  {sparkline(spark)}  oldest → newest"]
    emit(args, e, "\n".join(lines))


def cmd_sessions(args, data) -> None:
    rows = data.get("sessions", [])[: args.limit]
    lines = []
    for s in rows:
        # Schema 5: two workouts can share a date. The ordinal and the clock
        # time are what tell them apart — without them a two-a-day reads as the
        # same workout listed twice.
        stamp = s["date"]
        if (s.get("ordinal") or 1) > 1 or s.get("started_at"):
            when = s.get("started_at") or ""
            nth = f"#{s['ordinal']}" if (s.get("ordinal") or 1) > 1 else ""
            stamp = f"{s['date']} {when}{nth}".rstrip()
        head = f"  {stamp:<17}{s.get('day') or 'workout':<8}"
        body = f"{s['exercises']} exercises · {s['sets']} sets · {tonnage(s['volume'])} moved"
        if s.get("cardio_minutes"):
            body += f" · {clock(s['cardio_minutes'] * 60)} cardio"
        lines.append(f"{head} {body}")
        if s.get("top_lifts"):
            lines.append(f"           {' · '.join(s['top_lifts'])}")
    emit(args, rows, "Recent sessions\n" + ("\n".join(lines) or "  none yet"))


def cmd_volume(args, data) -> None:
    """Tonnage per week — the number that makes an hour of standing around add up."""
    sessions = data.get("sessions", [])
    if not sessions:
        emit(args, [], "Nothing logged yet.")
        return
    by_week: dict[str, dict] = {}
    for s in sessions:
        d = dt.date.fromisoformat(s["date"])
        monday = d - dt.timedelta(days=d.weekday())
        week = by_week.setdefault(monday.isoformat(),
                                  {"week_of": monday.isoformat(), "volume": 0.0,
                                   "sessions": 0, "sets": 0})
        week["volume"] += s.get("volume") or 0
        week["sessions"] += 1
        week["sets"] += s.get("sets") or 0

    weeks = sorted(by_week.values(), key=lambda w: w["week_of"])[-args.weeks:]
    values = [w["volume"] for w in weeks]
    lines = []
    for w in weeks:
        lines.append(f"  week of {w['week_of']}   {tonnage(w['volume']):>11}   "
                     f"{plural(w['sessions'], 'workout')} · {w['sets']} sets")
    if len(values) > 1:
        lines += ["", f"  {sparkline(values)}  oldest → newest"]
    total = sum(values)
    lines += ["", f"  {tonnage(total)} over {len(weeks)} weeks"]
    emit(args, weeks, "Load moved\n" + "\n".join(lines))


def cmd_cardio(args, data) -> None:
    """Minutes and miles. Deliberately never tonnage — converting a treadmill
    into pounds means inventing a rate nobody measured."""
    rows = [e for e in data.get("exercises", [])
            if e.get("modality", "strength") == "cardio"]
    if not rows:
        emit(args, [], "No cardio logged yet.")
        return

    sessions = data.get("sessions", [])
    if args.days:
        cutoff = (dt.date.today() - dt.timedelta(days=args.days)).isoformat()
        sessions = [s for s in sessions if s["date"] >= cutoff]
    total_minutes = sum(s.get("cardio_minutes") or 0 for s in sessions)
    total_miles = sum(s.get("cardio_distance") or 0 for s in sessions)

    window = f"last {args.days} days" if args.days else "all time"
    lines = [f"Cardio · {window}",
             f"  {clock(total_minutes * 60)} on the clock"
             + (f" · {miles(total_miles)} mi covered" if total_miles else ""),
             ""]
    for e in sorted(rows, key=lambda r: r["name"]):
        recent = e.get("recent", [])
        seconds = sum((s.get("cardio") or {}).get("seconds", 0) for s in recent)
        last = recent[0]["date"] if recent else "—"
        lines.append(f"  {e['name']:<22} {clock(seconds):>10}   last {last}")
        settings = e.get("machine_settings") or []
        if settings:
            lines.append("      set to "
                         + " · ".join(f"{m['label'].lower()} {m['value']}" for m in settings))
    emit(args, {"total_minutes": total_minutes, "total_miles": total_miles,
                "exercises": rows}, "\n".join(lines))


def cmd_machines(args, data) -> None:
    """Where every machine is set — the thing you otherwise rediscover by
    sitting down and finding out it is wrong."""
    rows = [e for e in data.get("exercises", []) if e.get("machine_settings")]
    if not rows:
        emit(args, [], "No machine settings recorded yet.\n"
                       "  Set them on the exercise screen in the app.")
        return
    lines = []
    for e in sorted(rows, key=lambda r: r["name"]):
        settings = " · ".join(f"{m['label'].lower()} {m['value']}"
                              for m in e["machine_settings"])
        lines.append(f"  {e['name']:<24} {settings}")
    emit(args, rows, "Machine settings\n" + "\n".join(lines))


def cmd_passes(args, data) -> None:
    rows = data.get("passes", [])
    lines = []
    for p in rows:
        flags = []
        if p.get("primary"):
            flags.append("door")
        if p.get("expired"):
            flags.append("EXPIRED")
        tag = f"  [{', '.join(flags)}]" if flags else ""
        where = f" · {p['location']}" if p.get("location") else ""
        lines.append(f"  {p['name']}{where}{tag}")
        detail = [p.get("symbology", "").upper(), p.get("member_id_masked") or "",
                  p.get("state") or ""]
        lines.append("      " + "  ".join(d for d in detail if d))
    lines.append("")
    # Stated every time on purpose: someone will eventually ask this tool for the
    # code, and the answer needs to be visibly a design decision, not a gap.
    lines.append("  Codes are never exported — they stay on the phone. Open the app to scan in.")
    emit(args, rows, "Stored passes\n" + "\n".join(lines))


def cmd_status(args, data) -> None:
    written = parse_ts(data.get("generated_at", ""))
    path = snapshot_path()
    stale = False
    if written:
        age = (dt.datetime.now(dt.timezone.utc) -
               written.replace(tzinfo=written.tzinfo or dt.timezone.utc)).total_seconds()
        stale = age > 36 * 3600
    payload = {"path": str(path), "generated_at": data.get("generated_at"),
               "app_version": data.get("app_version"), "schema": data.get("schema"),
               "stale": stale}
    text = (f"snapshot  {path}\n"
            f"written   {data.get('generated_at')}  ({ago(written)})\n"
            f"schema    {data.get('schema')}   app {data.get('app_version')}")
    if stale:
        text += ("\n\n  Stale. The phone has not written in over a day — either the app "
                 "has not been opened\n  or iCloud Drive is not syncing.")
    emit(args, payload, text)


def cmd_raw(args, data) -> None:
    print(json.dumps(data, indent=2))


# ---------------------------------------------------------------------- main

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="gym", description=__doc__.split("\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="The app writes; gym reads. Nothing here can change your log.")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    sub = p.add_subparsers(dest="command")

    sub.add_parser("today", help="the day's plan and progress").set_defaults(fn=cmd_today)

    w = sub.add_parser("weight", help="body weight and its trend")
    w.add_argument("--days", type=int, default=0, help="only the last N weigh-ins")
    w.set_defaults(fn=cmd_weight)

    sub.add_parser("lifts", help="working weight per exercise").set_defaults(fn=cmd_lifts)

    e = sub.add_parser("exercise", help="one lift's history")
    e.add_argument("name")
    e.set_defaults(fn=cmd_exercise)

    s = sub.add_parser("sessions", help="recent workouts")
    s.add_argument("--limit", type=int, default=10)
    s.set_defaults(fn=cmd_sessions)

    v = sub.add_parser("volume", help="how much you have moved, week by week")
    v.add_argument("--weeks", type=int, default=8)
    v.set_defaults(fn=cmd_volume)

    m = sub.add_parser("muscles", help="working sets per muscle group")
    m.add_argument("--days", type=int, default=7)
    m.set_defaults(fn=cmd_muscles)

    c = sub.add_parser("cardio", help="minutes and miles, never tonnage")
    c.add_argument("--days", type=int, default=30)
    c.set_defaults(fn=cmd_cardio)
    sub.add_parser("machines", help="where every machine is set").set_defaults(fn=cmd_machines)
    sub.add_parser("passes", help="stored gym passes (never the codes)").set_defaults(fn=cmd_passes)
    sub.add_parser("status", help="where the snapshot is and how fresh").set_defaults(fn=cmd_status)
    sub.add_parser("raw", help="the whole snapshot as JSON").set_defaults(fn=cmd_raw)
    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "fn", None):
        parser.print_help()
        return 0
    try:
        data = load()
    except NoSnapshot as e:
        print(str(e), file=sys.stderr)
        return 2
    args.fn(args, data)
    return 0


if __name__ == "__main__":
    sys.exit(main())

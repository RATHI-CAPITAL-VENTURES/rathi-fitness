<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDisplayName</key>
	<string>Fitness</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchGround</string>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>To read the weight your scale already wrote to Health, so you don't have to type it in twice.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>To save your workouts and weigh-ins to Health, so they show up in Fitness and on your watch.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>To play your own playlists during a workout, so the AirPods controls belong to this app and a squeeze can log a set.</string>
	<key>NSCameraUsageDescription</key>
	<string>To scan the code off your gym membership card so you can leave the card at home.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Fraunces-Regular.ttf</string>
		<string>Fraunces-SemiBold.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
	</array>
	<!-- ============================ The glasses ============================
	     Meta Ray-Ban Display, through Meta's Device Access Toolkit. Every key
	     in this block was settled on real hardware in a throwaway app first
	     (branch chore/lens-spike, FINDINGS.md). -->

	<!-- Meta AI hands control back through this scheme once you approve the
	     app there. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rathifitness</string>
			</array>
		</dict>
	</array>
	<!-- Lets the SDK ask iOS whether Meta AI is installed. Meta's setup guide
	     lists it as required and NEITHER of their sample apps carries it.
	     Without it: registration reads "unavailable" from launch, Connect
	     switches to Meta AI, and Meta AI shows nothing at all. No error
	     anywhere. That cost an hour. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>rathifitness://</string>
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<!-- Meta's binary reports crashes home unless told not to. This app
		     holds Health data; it is told not to. -->
		<key>CrashReporting</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
	<!-- From Meta's setup guide, and confirmed on the hardware: the glasses
	     announce this protocol to iOS (the accessory dump in the spike's console
	     lists "com.meta.ar.wearable" among "Meta RB Display"'s protocols). -->
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>To show your set and your rest timer on your glasses.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Your glasses fall back to Wi-Fi for anything heavier than text.</string>
	<!-- Verbatim from Meta's integration guide and both of their sample apps.
	     It does not look like a real service type and may well be a placeholder
	     they never replaced; it is kept because it is what the tested
	     configuration carried. Everything measured so far went over Bluetooth,
	     so whether the Wi-Fi path works at all is NOT known. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>

	<!-- `audio` is load-bearing twice over: it lets the app keep playing your
	     music with the screen locked, and it keeps the process alive so the
	     cooldown chime and its haptic actually fire while the phone is in a
	     pocket. Without it the rest ends as a silent notification. -->
	<!-- The three after `audio` are the glasses'. With them iOS will relaunch
	     the app in the background when the glasses connect, phone locked —
	     seen on the hardware. Meta's sample also declares `processing`; it is
	     left out because that mode wants BGTaskScheduler identifiers this app
	     has no use for. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<!-- Exposes the snapshot container in Files and, more to the point, on the
	     Mac at ~/Library/Mobile Documents/iCloud~com~rathi~fitness/Documents.
	     Without this the container exists but stays private to the app. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.rathi.fitness</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
			<key>NSUbiquitousContainerName</key>
			<string>Rathi Fitness</string>
		</dict>
	</dict>
</dict>
</plist>
